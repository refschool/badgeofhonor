{
  "name": "badgeofhonor",
  "version": "1.0.0",
  "description": "permet de lister les contributeur à un projet public permet de classer les contributeur par nombre de pull request",
  "main": "loader_CJS_to_ESM.cjs",
  "type": "module",
  "private": true,
  "scripts": {
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "tsx watch ./src/bin/www.ts",
    "build": "tsc -b && rollup -c",
    "preview": "cd ./dist/ && node --enable-source-maps www.js",
    "lint": "eslint -c 'eslint.config.js' src",
    "podman:build": "podman-compose up --build",
    "podman:star": "podman-compose up",
    "podman:stop": "podman-compose down -v",
    "podman:clean": "podman rmi -a",
    "docker:build": "docker-compose up --build",
    "docker:star": "docker-compose up",
    "docker:stop": "docker-compose down -v",
    "docker:clean": "docker rmi -a"
  },
  "keywords": [],
  "author": "Dan VIAL",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^9.12.0",
    "@rollup/plugin-commonjs": "^28.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-terser": "^0.4.4",
    "@rollup/plugin-typescript": "^12.1.0",
    "@stylistic/eslint-plugin": "^3.0.1",
    "@types/compression": "^1.7.5",
    "@types/debug": "^4.1.12",
    "@types/eslint__js": "^8.42.3",
    "@types/express": "^5.0.0",
    "@types/morgan": "^1.9.9",
    "@types/node": "^22.7.4",
    "eslint": "^9.12.0",
    "globals": "^15.10.0",
    "rollup": "^4.24.0",
    "rollup-plugin-copy": "^3.5.0",
    "tslib": "^2.7.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.2",
    "typescript-eslint": "^8.23.0"
  },
  "dependencies": {
    "compression": "^1.7.4",
    "debug": "^4.4.0",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "morgan": "^1.10.0",
    "octokit": "^4.0.2"
  }
}
